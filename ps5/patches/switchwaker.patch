+
+namespace {
+enum { Up = 1, Down = 2, Confirm = 4, Back = 8, Smaller = 16, Larger = 32, Help = 64, Activity = 128 };
+struct BrowserInput {
+    SDL_Gamepad* pad = nullptr;
+    bool owned = false;
+    bool mouseKnown = false;
+    float mouseX = 0, mouseY = 0;
+    ~BrowserInput() { if (owned && pad) SDL_CloseGamepad(pad); }
+    unsigned read() {
+        if (pad && !SDL_GamepadConnected(pad)) {
+            if (owned) SDL_CloseGamepad(pad);
+            pad = nullptr;
+            owned = false;
+        }
+        if (!pad) {
+            int count = 0;
+            SDL_JoystickID* ids = SDL_GetGamepads(&count);
+            if (ids && count > 0) {
+                pad = SDL_GetGamepadFromID(ids[0]);
+                if (!pad) { pad = SDL_OpenGamepad(ids[0]); owned = pad != nullptr; }
+            }
+            SDL_free(ids);
+        }
+        unsigned keys = 0;
+        if (pad) {
+            const int y = SDL_GetGamepadAxis(pad, SDL_GAMEPAD_AXIS_LEFTY);
+            for (auto axis : {SDL_GAMEPAD_AXIS_LEFTX, SDL_GAMEPAD_AXIS_LEFTY,
+                              SDL_GAMEPAD_AXIS_RIGHTX, SDL_GAMEPAD_AXIS_RIGHTY}) {
+                if (std::abs(SDL_GetGamepadAxis(pad, axis)) > 8000) keys |= Activity;
+            }
+            if (SDL_GetGamepadButton(pad, SDL_GAMEPAD_BUTTON_DPAD_UP) || y < -20000) keys |= Up;
+            if (SDL_GetGamepadButton(pad, SDL_GAMEPAD_BUTTON_DPAD_DOWN) || y > 20000) keys |= Down;
+            if (SDL_GetGamepadButton(pad, SDL_GAMEPAD_BUTTON_SOUTH)) keys |= Confirm;
+            if (SDL_GetGamepadButton(pad, SDL_GAMEPAD_BUTTON_EAST)) keys |= Back;
+            if (SDL_GetGamepadButton(pad, SDL_GAMEPAD_BUTTON_LEFT_SHOULDER)) keys |= Smaller;
+            if (SDL_GetGamepadButton(pad, SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER)) keys |= Larger;
+            if (SDL_GetGamepadButton(pad, SDL_GAMEPAD_BUTTON_WEST)) keys |= Help;
+            if (SDL_GetGamepadButton(pad, SDL_GAMEPAD_BUTTON_DPAD_LEFT) ||
+                SDL_GetGamepadButton(pad, SDL_GAMEPAD_BUTTON_DPAD_RIGHT)) keys |= Activity;
+        }
+        int count = 0;
+        const bool* key = SDL_GetKeyboardState(&count);
+        if (key && count > SDL_SCANCODE_PAGEDOWN) {
+            if (key[SDL_SCANCODE_UP]) keys |= Up;
+            if (key[SDL_SCANCODE_DOWN]) keys |= Down;
+            if (key[SDL_SCANCODE_RETURN]) keys |= Confirm;
+            if (key[SDL_SCANCODE_ESCAPE]) keys |= Back;
+            if (key[SDL_SCANCODE_PAGEDOWN]) keys |= Smaller;
+            if (key[SDL_SCANCODE_PAGEUP]) keys |= Larger;
+            if (count > SDL_SCANCODE_H && key[SDL_SCANCODE_H]) keys |= Help;
+            if (count > SDL_SCANCODE_LEFT && count > SDL_SCANCODE_RIGHT &&
+                (key[SDL_SCANCODE_LEFT] || key[SDL_SCANCODE_RIGHT])) keys |= Activity;
+        }
+        float x = 0, y = 0;
+        const auto buttons = SDL_GetMouseState(&x, &y);
+        if ((mouseKnown && (std::abs(x-mouseX) > .5f || std::abs(y-mouseY) > .5f)) || buttons)
+            keys |= Activity;
+        mouseX = x; mouseY = y; mouseKnown = true;
+        return keys;
+    }
+};
