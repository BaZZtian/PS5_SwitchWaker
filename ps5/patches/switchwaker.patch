+bool ps5StartSelectedDisc() {
+#if defined(PS5_MULTI_REGION)
+    const auto region = ps5_disc_region(gConfig.disc);
+    if (region == PS5_DISC_INVALID) return false;
+    if (strcmp(ps5_disc_id(region), COS_GAME_ID_STR) != 0) {
+        // A wrongly packaged engine must not bounce between executables.
+        // A matching engine may still recover by accepting another region
+        // if the originally selected drive/image became unavailable.
+        const char* handoff = getenv("COS_PS5_HANDOFF");
+        if (handoff && strcmp(handoff, COS_GAME_ID_STR) != 0) {
+            writef(STDERR_FILENO, "[cos] region: handoff engine does not match the selected disc\n");
+            return false;
+        }
+        const int error = ps5_load_disc_region(region, gConfig.disc);
+        writef(STDERR_FILENO, "[cos] region: unable to start %s, error 0x%x\n",
+               ps5_disc_id(region), (unsigned)error);
+        return false;
+    }
+#endif
+    return true;
+}
+bool ps5ResumeSelectedDisc() {
+#if defined(PS5_MULTI_REGION)
+    const char* handoff = getenv("COS_PS5_HANDOFF");
+    return handoff && !strcmp(handoff, COS_GAME_ID_STR) &&
+           ps5_disc_region(gConfig.disc) != PS5_DISC_INVALID &&
+           !strcmp(ps5_disc_id(ps5_disc_region(gConfig.disc)), COS_GAME_ID_STR) &&
+           checkDisc() == 0;
 #else
     return false;
 #endif
 }
 
