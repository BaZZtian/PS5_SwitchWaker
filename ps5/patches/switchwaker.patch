+// Switch's (switch/native/source/cos_switch.cpp), for a television and a faster machine.
+void ps5Defaults() {
+    ps5RegisterDiscSetting();
+    ps5FindDisc();
+    // European builds default to German unless the player has saved another language.
+#if VERSION == 3
+    ps5Default("COS_GAME_LANGUAGE", "de");
+#endif
+    ps5Default("COS_RUN_DIR", "/app0/user");
+    ps5Default("COS_ASPECT", "16:9");
+    // 60 images a second by interpolation (docs/FPS60_PLAN.md); the game's logic stays at 30
+    ps5Default("COS_FPS60", "1");
+    // the internal resolution is the output's (0: the window's size)
+    ps5Default("COS_FB_SCALE", "0");
+    // the render pipelines of the bundled list are compiled while the game starts
