+std::vector<std::string> ps5DiscsInFolder(const char* directory) {
+    std::vector<std::string> paths;
+    DIR* folder = opendir(directory);
+    if (folder == nullptr) {
+        return paths;
+    }
+    char found[512] = "";
+    while (paths.size() < 128) {
+        const dirent* entry = readdir(folder);
+        if (entry == nullptr) {
+            break;
+        }
+        const char* extension = strrchr(entry->d_name, '.');
+        if (extension == nullptr || (strcasecmp(extension, ".iso") != 0 &&
+                                    strcasecmp(extension, ".gcm") != 0 &&
+                                    strcasecmp(extension, ".ciso") != 0)) {
+            continue;
+        }
+        const int length = snprintf(found, sizeof(found), "%s/%s", directory, entry->d_name);
+        if (length >= 0 && (size_t)length < sizeof(found) && ps5DiscMatches(found)) {
+            paths.emplace_back(found);
+        }
+    }
+    closedir(folder);
+    std::sort(paths.begin(), paths.end());
+    return paths;
+}
+
+bool ps5DiscFromFolder(const char* directory) {
+    const auto paths = ps5DiscsInFolder(directory);
+    if (paths.empty()) {
+        return false;
+    }
+    ps5Default("COS_DISC", paths.front().c_str());
+    return true;
+}
+
+std::vector<std::string> ps5DiscPaths() {
+    std::vector<std::string> paths;
+    const auto add = [&](const char* directory) {
+        if (directory == nullptr || directory[0] != '/') {
+            return;
+        }
+        for (const auto& path : ps5DiscsInFolder(directory)) {
+            if (paths.size() < 128 && std::find(paths.begin(), paths.end(), path) == paths.end()) {
+                paths.push_back(path);
+            }
+        }
+    };
+    const char* preferred = pc_settings_get("COS_DISC_PATH");
+    if (preferred[0] == '/' && ps5DiscMatches(preferred)) {
+        paths.emplace_back(preferred);
+    }
+    add(pc_settings_get("COS_DISC_DIR"));
+    // Fresh installs use the existing internal app layout. External paths are optional.
+    add("/app0");
+    char directory[128];
+    for (unsigned int drive = 0; drive < 8; ++drive) {
+        snprintf(directory, sizeof(directory), "/mnt/usb%u/Homebrew/WindWaker-Discs", drive);
+        add(directory);
+        snprintf(directory, sizeof(directory), "/mnt/usb%u", drive);
+        add(directory);
+    }
+    return paths;
+}
+
+void ps5FindDisc() {
+    const char* selected = getenv("COS_DISC");
+    if (selected != nullptr && selected[0] != '\0' && access(selected, R_OK) == 0) {
+        return;
+    }
+    // A saved path may stop existing after an app update or USB renumbering.
+    unsetenv("COS_DISC");
+    const char* preferred = pc_settings_get("COS_DISC_PATH");
+    if (preferred[0] != '\0' && strcmp(preferred, "auto") != 0) {
+        if (preferred[0] == '/' && ps5DiscMatches(preferred)) {
+            ps5Default("COS_DISC", preferred);
+            return;
+        }
+        writef(STDERR_FILENO, "[cos] disc: saved selection unavailable or incompatible; searching automatically\n");
+    }
+    const char* customDirectory = pc_settings_get("COS_DISC_DIR");
+    if (customDirectory[0] == '/' && ps5DiscFromFolder(customDirectory)) {
+        return;
+    }
+    if (ps5DiscFromFolder("/app0")) {
+        return;
+    }
+    // Probe available external locations without assuming a particular USB number exists.
+    char directory[128];
+    for (unsigned int drive = 0; drive < 8; ++drive) {
+        snprintf(directory, sizeof(directory), "/mnt/usb%u/Homebrew/WindWaker-Discs", drive);
+        if (ps5DiscFromFolder(directory)) {
+            return;
+        }
+    }
+    for (unsigned int drive = 0; drive < 8; ++drive) {
+        snprintf(directory, sizeof(directory), "/mnt/usb%u", drive);
+        if (ps5DiscFromFolder(directory)) {
+            return;
+        }
+    }
+}
