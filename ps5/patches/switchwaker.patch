+// Persistent PS5 user data. Legacy card files are imported once, never replaced.
+#ifndef PC_PS5_USER_STORAGE_H
+#define PC_PS5_USER_STORAGE_H
+#include <cerrno>
+#include <cstdio>
+#include <cstring>
+#include <dirent.h>
+#include <string>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace pc {
+inline bool ps5UserDirectory(const std::string& path) {
+    if (mkdir(path.c_str(), 0777) != 0 && errno != EEXIST) return false;
+    struct stat status;
+    return stat(path.c_str(), &status) == 0 && S_ISDIR(status.st_mode);
+}
+
+inline bool ps5ImportUserFile(const std::string& from, const std::string& to) {
+    struct stat status;
+    // A persistent save takes precedence, including after an interrupted import.
+    if (stat(to.c_str(), &status) == 0) return S_ISREG(status.st_mode);
+    if (errno != ENOENT) return false;
+    FILE* input = fopen(from.c_str(), "rb");
+    if (!input) return false;
+    const std::string temporary = to + ".importing";
+    FILE* output = fopen(temporary.c_str(), "wb");
+    if (!output) { fclose(input); return false; }
+    char buffer[65536];
+    size_t count;
+    bool ok = true;
+    while ((count = fread(buffer, 1, sizeof(buffer), input)) != 0) {
+        if (fwrite(buffer, 1, count, output) != count) { ok = false; break; }
+    }
+    ok = !ferror(input) && !ferror(output) && ok;
+    if (fflush(output) != 0) ok = false;
+    if (fsync(fileno(output)) != 0) ok = false;
+    if (fclose(output) != 0) ok = false;
+    if (fclose(input) != 0) ok = false;
+    if (ok && stat(to.c_str(), &status) == 0) {
+        remove(temporary.c_str());
+        return S_ISREG(status.st_mode);
+    }
+    if (!ok || rename(temporary.c_str(), to.c_str()) != 0) {
+        remove(temporary.c_str());
+        return false;
+    }
+    return true;
+}
+
+inline bool ps5ImportCardFolder(const std::string& from, const std::string& to, unsigned depth = 0) {
+    // Card A/B contain regular GCI files; limit traversal of unexpected folders.
+    if (depth > 4) return false;
+    DIR* directory = opendir(from.c_str());
+    if (!directory) return errno == ENOENT;
+    bool ok = ps5UserDirectory(to);
+    while (ok) {
+        errno = 0;
+        const auto* entry = readdir(directory);
+        if (!entry) { ok = errno == 0; break; }
+        if (!strcmp(entry->d_name, ".") || !strcmp(entry->d_name, "..")) continue;
+        const std::string source = from + "/" + entry->d_name;
+        const std::string target = to + "/" + entry->d_name;
+        struct stat status;
+        if (stat(source.c_str(), &status) != 0) { ok = false; break; }
+        if (S_ISDIR(status.st_mode)) ok = ps5ImportCardFolder(source, target, depth + 1);
+        else if (S_ISREG(status.st_mode)) ok = ps5ImportUserFile(source, target);
+    }
+    closedir(directory);
+    return ok;
+}
+
+inline bool ps5PrepareUserStorage(const char* legacy = "/app0/user",
+                                  const char* persistent = "/data/windwaker/user") {
+    const std::string root(persistent);
+    const size_t slash = root.find_last_of('/');
+    if (slash == std::string::npos || !ps5UserDirectory(root.substr(0, slash)) ||
+        !ps5UserDirectory(root)) return false;
+    const std::string marker = root + "/.legacy-cards-imported";
+    if (access(marker.c_str(), F_OK) == 0) return true;
+    for (const char* region : {"EUR", "USA", "JAP"}) {
+        if (!ps5ImportCardFolder(std::string(legacy) + "/" + region, root + "/" + region)) return false;
+    }
+    // Retain controller mappings and UI placement where they already exist.
+    for (const char* name : {"controller_ports.dat", "imgui.ini"}) {
+        const std::string source = std::string(legacy) + "/" + name;
+        if (access(source.c_str(), F_OK) == 0 && !ps5ImportUserFile(source, root + "/" + name)) return false;
+    }
+    // This operational marker prevents old deleted card files being reimported later.
+    const std::string temporary = marker + ".tmp";
+    FILE* file = fopen(temporary.c_str(), "wb");
+    if (!file) return false;
+    bool ok = fputs("version=1\n", file) >= 0 && fflush(file) == 0 && fsync(fileno(file)) == 0;
+    if (fclose(file) != 0) ok = false;
+    if (!ok || rename(temporary.c_str(), marker.c_str()) != 0) { remove(temporary.c_str()); return false; }
+    return true;
+}
+} // namespace pc
+#endif
