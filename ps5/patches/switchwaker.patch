+// Select only the build's revision-0 disc, including the CISO layout accepted by checkDisc.
+// checkDisc still performs the normal disc and game-data checks after selection.
+bool ps5DiscMatches(const char* path) {
+#if defined(PS5_MULTI_REGION)
+    return ps5_disc_region(path) != PS5_DISC_INVALID;
+#else
+    FILE* file = fopen(path, "rb");
+    if (file == nullptr) {
+        return false;
+    }
+    unsigned char header[0x20];
+    bool readable = fread(header, 1, sizeof(header), file) == sizeof(header);
+    if (readable && memcmp(header, "CISO", 4) == 0) {
+        readable = header[8] != 0 && fseek(file, 0x8000, SEEK_SET) == 0 &&
+                   fread(header, 1, sizeof(header), file) == sizeof(header);
+    }
+    fclose(file);
+    return readable && memcmp(header, COS_GAME_ID_STR, 6) == 0 && header[7] == 0 &&
+           header[0x1C] == 0xC2 && header[0x1D] == 0x33 && header[0x1E] == 0x9F &&
+           header[0x1F] == 0x3D;
+#endif
