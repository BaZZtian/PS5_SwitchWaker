+
+std::vector<std::string> ps5AvailableDiscs() { return ps5DiscPaths(); }
+bool ps5CompatibleDisc(const char* path) { return ps5DiscMatches(path); }
+
+void ps5RegisterDiscSetting() {
+    // Refresh before menu initialization after the startup browser chooses another folder.
+    // Stored vectors keep the registry's string pointers valid until the next refresh.
+    static std::vector<std::string> paths;
+    static std::vector<PcSettingChoice> choices;
+    paths = ps5DiscPaths();
+    choices.clear();
+    choices.reserve(paths.size() + 1);
+    choices.push_back({"auto", "AutomÃ¡tico", "Automatic"});
+    for (const auto& path : paths) {
+        choices.push_back({path.c_str(), path.c_str(), path.c_str()});
+    }
+    const PcSettingDesc desc = {
+        "COS_DISC_PATH", "Imagen de disco",
+        "Elige una imagen detectada con izquierda/derecha. Se aplica al reiniciar. "
+        "Para otra carpeta, configura COS_DISC_DIR en /data/windwaker/settings.ini.",
+        PC_SETTING_TAB_DEBUG, PC_SETTING_RESTART, choices.data(), (int)choices.size(), "auto",
+        nullptr, nullptr, 0, "Disc image",
+        "Use left/right to choose a detected image. Takes effect after restart. "
+        "For another folder, set COS_DISC_DIR in /data/windwaker/settings.ini."
+    };
+    pc_settings_register(&desc);
+}
+
+// Validate the current engine normally; another supported region is checked
+// again by its own engine after handoff, before any game data loads.
+bool ps5ValidateSelectedDisc() {
+#if defined(PS5_MULTI_REGION)
+    const auto region = ps5_disc_region(gConfig.disc);
+    if (region == PS5_DISC_INVALID) return false;
+    if (strcmp(ps5_disc_id(region), COS_GAME_ID_STR) != 0) return true;
+#endif
