diff --git a/native/src/pc/runtime/pc_ps5_disc_art.h b/native/src/pc/runtime/pc_ps5_disc_art.h
new file mode 100644
index 0000000..cbac53a
--- /dev/null
+++ b/native/src/pc/runtime/pc_ps5_disc_art.h
@@ -0,0 +1,51 @@
+// Original PS5 app artwork, converted losslessly during title packaging.
+#ifndef PC_PS5_DISC_ART_H
+#define PC_PS5_DISC_ART_H
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+#include <aurora/imgui.h>
+#include <imgui.h>
+namespace pc {
+struct Ps5DiscBackdrop {
+    ImTextureID texture = 0;
+    uint32_t width = 0, height = 0;
+    Ps5DiscBackdrop() {
+        FILE* file = fopen("/app0/res/disc-background.rgba", "rb");
+        if (!file) return;
+        uint32_t header[3] = {};
+        const bool valid = fread(header, sizeof(header), 1, file) == 1 &&
+                           header[0] == 0x47425757 && header[1] && header[2] &&
+                           header[1] <= 8192 && header[2] <= 8192 &&
+                           uint64_t(header[1]) * header[2] <= 16777216;
+        if (valid) {
+            std::vector<uint8_t> pixels(size_t(header[1]) * header[2] * 4);
+            if (fread(pixels.data(), 1, pixels.size(), file) == pixels.size()) {
+                width = header[1]; height = header[2];
+                texture = aurora_imgui_add_texture(width, height, pixels.data());
+            }
+        }
+        fclose(file);
+    }
+    void draw(ImVec2 size) const {
+        ImDrawList* list = ImGui::GetBackgroundDrawList();
+        if (texture) {
+            const float display = size.x / std::max(size.y, 1.f);
+            const float image = float(width) / height;
+            const float u = image > display ? (1.f - display/image)*.5f : 0.f;
+            const float v = image < display ? (1.f - image/display)*.5f : 0.f;
+            list->AddImage(texture, ImVec2(0,0), size, ImVec2(u,v), ImVec2(1-u,1-v));
+        } else {
+            list->AddRectFilledMultiColor(ImVec2(0,0),size,
+                IM_COL32(25,107,157,255),IM_COL32(62,168,181,255),
+                IM_COL32(9,61,100,255),IM_COL32(8,74,115,255));
+        }
+        list->AddRectFilledMultiColor(ImVec2(0,0),size,
+            IM_COL32(4,28,48,125),IM_COL32(4,28,48,55),
+            IM_COL32(4,28,48,90),IM_COL32(4,28,48,90));
+    }
+};
+}
+#endif
diff --git a/native/src/pc/runtime/pc_ps5_disc_browser.h b/native/src/pc/runtime/pc_ps5_disc_browser.h
new file mode 100644
index 0000000..6a37b37
--- /dev/null
+++ b/native/src/pc/runtime/pc_ps5_disc_browser.h
@@ -0,0 +1,120 @@
+// PS5 startup disc browser: filesystem navigation without game or graphics dependencies.
+#ifndef PC_PS5_DISC_BROWSER_H
+#define PC_PS5_DISC_BROWSER_H
+#include <algorithm>
+#include <cstring>
+#include <dirent.h>
+#include <string>
+#include <strings.h>
+#include <sys/stat.h>
+#include <vector>
+
+namespace pc {
+struct Ps5DiscBrowser {
+    enum class Kind { Directory, Image, Browse, Rescan };
+    struct Row { Kind kind; std::string name, path; };
+    using Discover = std::vector<std::string>(*)();
+    using Matches = bool(*)(const char*);
+    Discover discover;
+    Matches matches;
+    std::vector<Row> rows;
+    std::string folder, root, error;
+    int selected = 0;
+    bool detected = true;
+    bool truncated = false;
+    explicit Ps5DiscBrowser(Discover scan, Matches check) : discover(scan), matches(check) { refresh(); }
+    std::string savedImage(const char* preferred) const {
+        if (!preferred || preferred[0] != '/') return {};
+        if (matches(preferred)) return preferred;
+        const char* basename = strrchr(preferred, '/');
+        if (!basename || !basename[1]) return {};
+        std::string recovered;
+        for (const auto& row : rows) {
+            if (row.kind != Kind::Image) continue;
+            const char* name = strrchr(row.path.c_str(), '/');
+            if (name && !strcmp(name + 1, basename + 1)) {
+                if (!recovered.empty()) return {}; // Ambiguous USB recovery needs a choice.
+                recovered = row.path;
+            }
+        }
+        return recovered;
+    }
+    static bool directory(const std::string& path) {
+        DIR* dir = opendir(path.c_str());
+        if (!dir) return false;
+        closedir(dir);
+        return true;
+    }
+    void refresh() {
+        rows.clear();
+        truncated = false;
+        error.clear();
+        selected = 0;
+        if (detected) {
+            for (const auto& path : discover()) rows.push_back({Kind::Image, path, path});
+            rows.push_back({Kind::Browse, "", ""});
+        } else if (folder.empty()) {
+            if (directory("/app0")) rows.push_back({Kind::Directory, "App folder (/app0)", "/app0"});
+            for (unsigned drive = 0; drive < 8; ++drive) {
+                const auto path = "/mnt/usb" + std::to_string(drive);
+                if (directory(path)) rows.push_back({Kind::Directory, "USB " + std::to_string(drive), path});
+            }
+            for (const char* path : {"/mnt/ext0", "/mnt/ext1", "/data"}) {
+                if (directory(path)) rows.push_back({Kind::Directory, path, path});
+            }
+        } else {
+            DIR* dir = opendir(folder.c_str());
+            if (!dir) {
+                error = "directory";
+            } else {
+                while (const auto* item = readdir(dir)) {
+                    if (!strcmp(item->d_name, ".") || !strcmp(item->d_name, "..")) continue;
+                    const std::string path = folder + "/" + item->d_name;
+                    struct stat status;
+                    if (stat(path.c_str(), &status) != 0) continue;
+                    const char* ext = strrchr(item->d_name, '.');
+                    if (S_ISDIR(status.st_mode)) rows.push_back({Kind::Directory, item->d_name, path});
+                    else if (S_ISREG(status.st_mode) && ext &&
+                             (!strcasecmp(ext, ".iso") || !strcasecmp(ext, ".gcm") || !strcasecmp(ext, ".ciso"))) {
+                        rows.push_back({Kind::Image, item->d_name, path});
+                    }
+                    if (rows.size() == 512) { truncated = true; break; }
+                }
+                closedir(dir);
+                std::sort(rows.begin(), rows.end(), [](const Row& a, const Row& b) {
+                    if (a.kind != b.kind) return a.kind == Kind::Directory;
+                    return a.name < b.name;
+                });
+            }
+        }
+        rows.push_back({Kind::Rescan, "", ""});
+    }
+    void move(int direction) {
+        if (!rows.empty()) selected = (selected + direction + (int)rows.size()) % (int)rows.size();
+    }
+    std::string activate() {
+        if (selected < 0 || selected >= (int)rows.size()) return {};
+        const Row row = rows[selected];
+        if (row.kind == Kind::Rescan) refresh();
+        else if (row.kind == Kind::Browse) { detected = false; folder.clear(); root.clear(); refresh(); }
+        else if (row.kind == Kind::Directory) {
+            if (!directory(row.path)) { error = "directory"; return {}; }
+            if (folder.empty()) root = row.path;
+            folder = row.path;
+            refresh();
+        } else if (matches(row.path.c_str())) {
+            return row.path;
+        } else error = "image";
+        return {};
+    }
+    void back() {
+        if (detected) return;
+        if (folder.empty()) { detected = true; refresh(); }
+        else {
+            folder = folder == root ? "" : folder.substr(0, folder.find_last_of('/'));
+            refresh();
+        }
+    }
+};
+} // namespace pc
+#endif
diff --git a/native/src/pc/runtime/pc_ps5_disc_layout.h b/native/src/pc/runtime/pc_ps5_disc_layout.h
new file mode 100644
index 0000000..c345174
--- /dev/null
+++ b/native/src/pc/runtime/pc_ps5_disc_layout.h
@@ -0,0 +1,17 @@
+// TV-distance layout in logical display pixels, independent of graphics bindings.
+#ifndef PC_PS5_DISC_LAYOUT_H
+#define PC_PS5_DISC_LAYOUT_H
+#include <algorithm>
+namespace pc {
+struct Ps5DiscLayout {
+    float scale, text, title, margin, row;
+    float panelX, panelY, panelWidth, panelHeight;
+};
+inline Ps5DiscLayout ps5DiscLayout(float width, float height, float preference = 1.f) {
+    const float scale = std::max(0.1f, std::min(width / 1920.f, height / 1080.f));
+    const float text = 32.f * scale * std::clamp(preference, 0.75f, 1.5f);
+    return {scale, text, 60.f * scale, 28.f * scale, text * 2.7f,
+            width * 0.075f, height * 0.23f, width * 0.85f, height * 0.69f};
+}
+} // namespace pc
+#endif
