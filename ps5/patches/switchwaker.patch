+int pc_settings_set_startup(const char* key, const char* value) {
+    State& s = st();
+    Entry* e = find(key);
+    if (e == nullptr || !e->registered || isLocked(key) || value == nullptr) {
+        return -1;
+    }
+    const std::string before = valueFor(key, s.lastMode);
+    const int slot = perMode(*e) ? 1 + s.lastMode : 0;
+    e->stored[slot] = value;
+    e->has[slot] = true;
+    const bool saved = (e->desc.flags & PC_SETTING_NO_SAVE) || writeFile();
+    e->bootValue = valueFor(key, s.lastMode);
+    if (e->bootValue != before) {
+        notify(*e, key, e->bootValue);
+    }
+    return saved ? 0 : 1;
+}
