+        sDebugShotPath = partial;
+        sDebugShotOverlay = true;
+        sDebugShotAsked++;
+    }
+    debugShotFrameEnd(frame);
+    char name[64];
+    snprintf(name, sizeof(name), "/app0/user/screenshots/grab-%04u.png", grabs++);
+    chmod(partial, 0666);
+    if (rename(partial, name) != 0) {
+        writef(STDERR_FILENO, "[cos] ps5: grab: no picture written\n");
+    }
