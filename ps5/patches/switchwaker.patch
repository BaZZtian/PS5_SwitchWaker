+    case 1: rax = (rax & ~0xFFFFull) | ((rax & 0xFF) << 8); break; // AL = 0, AH = the dividend's low byte
+    case 2: rdx = (rdx & ~0xFFFFull) | (rax & 0xFFFF); rax &= ~0xFFFFull; break;
+    case 4: rdx = rax & 0xFFFFFFFFull; rax = 0; break;
+    default: rdx = rax; rax = 0; break;
+    }
+    uc->uc_mcontext.mc_rip += length;
