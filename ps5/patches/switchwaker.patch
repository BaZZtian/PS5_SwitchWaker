+// There is no file dialog and no command line: the disc is the first .iso, .gcm or .ciso in the
+// title's folder, then on a USB drive. checkDisc says what is wrong with it, if anything.
+void ps5FindDisc() {
+    if (getenv("COS_DISC") != nullptr) {
+        return;
+    }
+    for (const char* dir : {"/app0", "/mnt/usb0", "/mnt/usb1"}) {
+        DIR* d = opendir(dir);
+        if (d == nullptr) {
+            continue;
+        }
+        char found[512] = "";
+        while (const dirent* e = readdir(d)) {
+            const char* dot = strrchr(e->d_name, '.');
+            if (dot != nullptr && (strcasecmp(dot, ".iso") == 0 || strcasecmp(dot, ".gcm") == 0 ||
+                                   strcasecmp(dot, ".ciso") == 0)) {
+                snprintf(found, sizeof(found), "%s/%s", dir, e->d_name);
+                break;
+            }
+        }
+        closedir(d);
+        if (found[0] != '\0') {
+            ps5Default("COS_DISC", found);
+            return;
+        }
+    }
